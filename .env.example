# === API Kalitlar ===
# Anthropic: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Tavily: https://tavily.com → API (tekin: 1000 qidiruv/oy)
TAVILY_API_KEY=

# LangSmith: https://smith.langchain.com (ixtiyoriy)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=sales_agent

# === Email (Gmail SMTP) — ixtiyoriy ===
# Google Account → Security → 2FA → App Passwords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# === Server ===
HOST=0.0.0.0
PORT=8000
